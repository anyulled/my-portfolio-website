  "packageManager": "npm@11.19.1",
  "private": true,
  "scripts": {
    "build": "npm run check-i18n && next build",
    "build:harness": "HARNESS_MODE=fixture SUPABASE_URL=https://fixture.invalid SUPABASE_ANON_KEY=fixture npm run build",
    "check-i18n": "tsx src/app/messagesChecker.ts",
    "doctor": "tsx scripts/harness/doctor.ts && npm run harness:check",
    "dev": "next dev --turbopack",
    "dev:harness": "HARNESS_MODE=fixture SUPABASE_URL=https://fixture.invalid SUPABASE_ANON_KEY=fixture next dev --turbopack",
    "e2e": "npm run build:harness && npm run e2e:run",
    "e2e:run": "playwright test",
    "e2e:preview": "playwright test --config=playwright.preview.config.ts",
    "harness:check": "tsx scripts/harness/check.ts",
    "harness:clean": "tsx scripts/harness/clean.ts",
    "harness:yaml": "tsx scripts/harness/yaml.ts",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,json,yml,yaml}\"",
    "prepare": "husky",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,yml,yaml}\"",
    "start": "next start",
    "start:harness": "HARNESS_MODE=fixture SUPABASE_URL=https://fixture.invalid SUPABASE_ANON_KEY=fixture next start",
    "supabase:migrate": "supabase migration up",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand && npm run test:coverage:changed && npm run test:coverage:baseline",
    "test:coverage:baseline": "tsx scripts/harness/coverage-baseline.ts",
    "test:coverage:changed": "tsx scripts/harness/changed-coverage.ts",
    "test:watch": "jest --watch",
    "test:mutation": "stryker run",
    "audit:ci": "npm audit --audit-level=high",
    "docs": "typedoc",
    "api:lint": "redocly lint docs/openapi.yaml",
    "cache:flush": "tsx scripts/cache/flush.ts",
    "typecheck": "tsc --noEmit",
    "verify:quick": "npm run harness:check && npm run harness:yaml && npm run lint:ci && npm run format:check && npm run typecheck",
    "verify": "npm run verify:quick && npm run test:coverage && npm run build:harness && npm run api:lint",
    "verify:full": "npm run verify && npm run e2e:run",
    "verify:nightly": "npm run verify:full && npm run test:mutation && npm run docs",
    "verify:preview": "npm run e2e:preview"
  },
  "version": "0.1.0"
}
